{
  "name": "event-pubsub",
  "version": "6.0.0",
  "description": "Small, synchronous, extensible publish/subscribe events for modern Node.js and browsers.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "CHANGELOG.md",
    "MIGRATION.md",
    "README.md",
    "SECURITY.md",
    "licence"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node ./test/node.js",
    "test:unit": "node ./test/node.js unit",
    "test:functional": "node ./test/node.js functional",
    "test:integration": "node ./test/node.js integration",
    "test:regression": "node ./test/node.js regression",
    "coverage": "vanilla-test coverage all",
    "coverage:node": "vanilla-test coverage node",
    "coverage:chrome": "vanilla-test coverage chrome",
    "benchmark": "node ./benchmark/run.js",
    "benchmark:smoke": "node ./benchmark/run.js --smoke",
    "test:package": "node ./scripts/package-smoke.js",
    "site:check": "node ./scripts/site-check.js",
    "site:assemble": "node ./scripts/assemble-site.js _site",
    "site:deployment-check": "node ./scripts/deployment-check.js _site",
    "start": "node ./scripts/serve.js",
    "verify": "npm test && npm run coverage && npm run benchmark:smoke && npm run test:package && npm run site:check && npm run site:assemble && npm run site:deployment-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIAEvangelist/event-pubsub.git"
  },
  "homepage": "https://riaevangelist.github.io/event-pubsub/",
  "bugs": {
    "url": "https://github.com/RIAEvangelist/event-pubsub/issues"
  },
  "funding": "https://github.com/sponsors/RIAEvangelist",
  "keywords": [
    "event",
    "events",
    "pubsub",
    "publish-subscribe",
    "event-emitter",
    "node",
    "browser",
    "esm"
  ],
  "author": "Brandon Nozaki Miller",
  "license": "MIT",
  "devDependencies": {
    "vanilla-test": "2.1.1"
  }
}
